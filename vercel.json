{
  "buildCommand": "node scripts/fetch-content.js && vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/content.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
